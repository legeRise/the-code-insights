---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout
  title="Muhammad Habib ur Rehman Khan — Backend / Full-Stack Developer"
  description="Muhammad Habib ur Rehman Khan is a Python/Django backend and full-stack developer building production systems, APIs, AI products, and mobile-facing applications."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Backend / Full-Stack Developer</p>
      <h1>Muhammad Habib<br />ur Rehman Khan</h1>
      <p class="hero-lede">I build production software, AI products, APIs, and business systems — from backend architecture to the interfaces people actually use.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore my work</a>
        <a class="button" href="mailto:official.habib92@gmail.com">Get in touch</a>
      </div>
      <div class="hero-meta"><span>Python · Django · DRF</span><span>Pakistan</span><span>Building since 2020</span></div>
    </div>
    <aside class="hero-card" aria-label="Developer snapshot">
      <div class="status"><i></i> Open to opportunities</div>
      <div class="snapshot-row"><strong>Backend</strong><span>Django · DRF · Flask · FastAPI</span></div>
      <div class="snapshot-row"><strong>Systems</strong><span>PostgreSQL · Celery · Redis · Linux</span></div>
      <div class="snapshot-row"><strong>AI</strong><span>OpenAI · LangChain · AI workflows</span></div>
      <div class="snapshot-row"><strong>Frontend</strong><span>React · React Native · HTMX</span></div>
    </aside>
  </section>

  <section class="proof-strip" aria-label="Profile highlights">
    <div><strong>2+</strong><span>years professional development</span></div>
    <div><strong>Production</strong><span>business systems & APIs</span></div>
    <div><strong>Shipped</strong><span>mobile + AI products</span></div>
  </section>

  <section id="work" class="portfolio-section">
    <div class="section-title"><div><p class="eyebrow">Selected work</p><h2>Things I've actually built.</h2></div><a href={`${base}projects`}>All projects →</a></div>
    <div class="project-grid">
      <a class="project-card project-featured" href={`${base}projects/ezlog`}>
        <div class="project-top"><span class="project-number">01</span><span class="tag">Personal</span></div>
        <h3>EzTajweed</h3>
        <p>Interactive Quran learning application with an IndoPak 16-line Mushaf, ayah navigation, audio, translations, Tajweed explanations, and quiz-based practice.</p>
        <div class="chips"><span>React Native</span><span>Django REST</span><span>PostgreSQL</span></div>
        <span class="project-arrow">View project ↗</span>
      </a>
      <a class="project-card" href="https://github.com/legeRise/ezclip-backend" target="_blank" rel="noreferrer">
        <div class="project-top"><span class="project-number">02</span><span class="tag">AI product</span></div>
        <h3>EzClip</h3>
        <p>AI video generation backend that turns scripts into narrated videos with generated visuals, captions, cinematic effects, and live progress tracking.</p>
        <div class="chips"><span>Django</span><span>Celery</span><span>Redis</span><span>R2</span></div>
        <span class="project-arrow">View on GitHub ↗</span>
      </a>
      <article class="project-card">
        <div class="project-top"><span class="project-number">03</span><span class="tag">Professional</span></div>
        <h3>Upkeep Shoes</h3>
        <p>Business management system covering customer orders, employee tasks, statuses, reports, notifications, invoices, and operational workflows.</p>
        <div class="chips"><span>Django</span><span>DRF</span><span>JavaScript</span></div>
      </article>
      <article class="project-card">
        <div class="project-top"><span class="project-number">04</span><span class="tag">Professional</span></div>
        <h3>Yole Validation System</h3>
        <p>Role-based approval and validation flows for products and stores, with auditing, notifications, access control, and process tracking.</p>
        <div class="chips"><span>Django</span><span>HTMX</span><span>JavaScript</span></div>
      </article>
      <article class="project-card">
        <div class="project-top"><span class="project-number">05</span><span class="tag">Professional</span></div>
        <h3>Arbzoom</h3>
        <p>Arbitrage betting platform features spanning opportunities, wallets, bet approvals, admin controls, and scheduled platform workflows.</p>
        <div class="chips"><span>Django</span><span>Celery</span><span>HTMX</span></div>
      </article>
      <article class="project-card">
        <div class="project-top"><span class="project-number">06</span><span class="tag">AI product</span></div>
        <h3>Hotshot AI</h3>
        <p>Product chatbot using product data for structured retrieval, product lookup, FAQ-style answers, and solution suggestions.</p>
        <div class="chips"><span>Flask</span><span>OpenAI</span><span>REST APIs</span></div>
      </article>
    </div>
  </section>

  <section class="experience-section">
    <div class="section-title"><div><p class="eyebrow">Experience</p><h2>Where I've worked.</h2></div></div>
    <div class="experience-item"><div class="experience-date">Aug 2024 — Present</div><div><h3>Better AI <small>Python Developer</small></h3><p>Production Django/Flask applications, REST APIs, Celery workflows, AI integrations, third-party APIs, frontend integration, Linux/Nginx deployment support, and production debugging.</p></div></div>
    <div class="experience-item"><div class="experience-date">2024 — 2025</div><div><h3>Software Engineering <small>COMSATS University Islamabad</small></h3><p>BS Software Engineering · Jun 2020 — Jun 2024</p></div></div>
  </section>

  <section class="stack-section">
    <p class="eyebrow">Toolkit</p>
    <h2>A practical stack.</h2>
    <div class="stack-grid">
      <div><strong>Backend</strong><span>Python · Django · DRF · Flask · FastAPI</span></div>
      <div><strong>Data & async</strong><span>PostgreSQL · Celery · Redis · background jobs</span></div>
      <div><strong>Frontend</strong><span>JavaScript · React · React Native · HTMX · HTML/CSS</span></div>
      <div><strong>AI & APIs</strong><span>OpenAI · LangChain · REST APIs · integrations</span></div>
      <div><strong>Infrastructure</strong><span>Linux · Nginx · Git · production debugging</span></div>
    </div>
  </section>

  <section class="notes-section">
    <div class="section-title"><div><p class="eyebrow">Engineering notes</p><h2>I write about what I build.</h2></div><a href={`${base}articles`}>Read notes →</a></div>
    <p class="lede">The Code Insight started as a place for technical notes. It stays here — now alongside the work behind them.</p>
  </section>

  <section class="contact-section">
    <p class="eyebrow">Have a project?</p>
    <h2>Let's build something useful.</h2>
    <p>For work, collaboration, or just a technical conversation.</p>
    <div class="hero-actions"><a class="button button-primary" href="mailto:official.habib92@gmail.com">official.habib92@gmail.com</a><a class="button" href="https://github.com/legeRise" target="_blank" rel="noreferrer">GitHub ↗</a></div>
  </section>
</BaseLayout>
