---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
const personal = projects.filter(({ data }) => data.type === 'personal');
const professional = projects.filter(({ data }) => data.type === 'professional');
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const assetUrl = (path: string) => path.startsWith('/') ? `${base}${path.slice(1)}` : path;
---
<BaseLayout title="Projects" description="Personal products and professional systems built by Muhammad Habib ur Rehman Khan.">
  <div class="narrow"><p class="eyebrow">Selected work</p><h1>Things I've built.</h1><p class="lede">Personal products, production systems, and the engineering work behind them.</p></div>

  <section class="portfolio-section project-list-section">
    <div class="section-head"><h2>Professional work</h2><span>Production systems</span></div>
    <div class="cards">
      {professional.map(({ id, data }) => (
        <article class="card project-card-list">
          {data.image && <img src={assetUrl(data.image)} alt="" />}
          <div class="project-top"><span class="tag">Professional</span></div>
          <h2><a href={`${base}projects/${id}`}>{data.title}</a></h2>
          <p>{data.description}</p>
          <div class="project-links">
            <a href={`${base}projects/${id}`}>Case study →</a>
            {data.url && <a href={data.url} target="_blank" rel="noreferrer">Visit product ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="portfolio-section project-list-section">
    <div class="section-head"><h2>Personal projects</h2><span>Things I build independently</span></div>
    <div class="cards">
      {personal.map(({ id, data }) => (
        <article class="card project-card-list">
          {data.image && <img src={assetUrl(data.image)} alt="" />}
          <div class="project-top"><span class="tag">Personal</span></div>
          <h2><a href={`${base}projects/${id}`}>{data.title}</a></h2>
          <p>{data.description}</p>
          <div class="project-links">
            <a href={`${base}projects/${id}`}>View project →</a>
            {data.url && <a href={data.url} target="_blank" rel="noreferrer">Visit live ↗</a>}
            {data.repository && <a href={data.repository} target="_blank" rel="noreferrer">Source ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
