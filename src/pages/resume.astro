---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const resumePdf = `${base}Muhammad_Habib_ur_Rehman_Khan_CV_Final.pdf`;
---

<BaseLayout title="My Resume">
  <article class="resume-view-page">
    <header class="resume-view-head">
      <div>
        <p class="eyebrow">My Resume</p>
        <h1>A closer look at my experience.</h1>
        <p class="lede">Read the full resume here, or download the original PDF.</p>
      </div>
      <a class="button button-primary" href={resumePdf} download>Download Resume ↓</a>
    </header>

    <section class="resume-glass" aria-label="Resume PDF viewer">
      <div class="resume-glass-bar">
        <div class="resume-glass-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <span>muhammad_habib_ur_rehman_khan · resume.pdf</span>
        <a href={resumePdf} target="_blank" rel="noreferrer">Open PDF ↗</a>
      </div>
      <div class="resume-frame-wrap">
        <iframe title="Muhammad Habib ur Rehman Khan resume" src={resumePdf}></iframe>
      </div>
    </section>

    <p class="resume-view-note">The viewer uses the same PDF available from the download button, so there is only one resume to keep up to date.</p>
  </article>
</BaseLayout>

<style>
  .resume-view-page {
    padding: clamp(3.5rem, 7vw, 6rem) 0 5rem;
  }

  .resume-view-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .resume-view-head h1 {
    max-width: 15ch;
    font-size: clamp(2.2rem, 5vw, 4rem);
    margin: 0;
  }

  .resume-view-head .lede {
    margin: .9rem 0 0;
  }

  .resume-glass {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--line));
    border-radius: 1.35rem;
    padding: .65rem;
    background:
      radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 28%),
      linear-gradient(145deg, color-mix(in srgb, var(--surface) 88%, transparent), color-mix(in srgb, var(--bg) 94%, transparent));
    box-shadow: 0 30px 100px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.08);
    backdrop-filter: blur(22px);
    overflow: hidden;
  }

  .resume-glass-bar {
    min-height: 2.6rem;
    display: grid;
    grid-template-columns: 5rem 1fr 5rem;
    align-items: center;
    gap: .75rem;
    padding: 0 .65rem;
    color: var(--muted);
    font: .68rem ui-monospace, "Cascadia Code", monospace;
  }

  .resume-glass-bar > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
  }

  .resume-glass-bar a {
    justify-self: end;
    color: var(--muted);
  }

  .resume-glass-dots { display: flex; gap: .35rem; }
  .resume-glass-dots i { width: .48rem; height: .48rem; border-radius: 50%; background: var(--line); display: block; }
  .resume-glass-dots i:first-child { background: color-mix(in srgb, var(--accent) 55%, var(--line)); }

  .resume-frame-wrap {
    height: min(78vh, 980px);
    min-height: 650px;
    border-radius: .9rem;
    overflow: hidden;
    background: #e9ece9;
    box-shadow: 0 12px 40px rgba(0,0,0,.2);
  }

  .resume-frame-wrap iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  .resume-view-note {
    margin: 1rem auto 0;
    max-width: 70ch;
    text-align: center;
    color: var(--muted);
    font-size: .78rem;
  }

  @media (max-width: 700px) {
    .resume-view-head { align-items: start; flex-direction: column; }
    .resume-view-head .button { width: 100%; }
    .resume-glass { padding: .4rem; border-radius: 1rem; }
    .resume-glass-bar { grid-template-columns: 3.5rem 1fr 3.5rem; font-size: .6rem; }
    .resume-frame-wrap { min-height: 560px; height: 75vh; border-radius: .7rem; }
  }
</style>
