---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const resumePdf = `${base}habib_resume_9_aug_2026.pdf`;
---

<BaseLayout title="My Resume">
  <article class="resume-page">
    <header class="resume-head">
      <div>
        <p class="eyebrow">My Resume</p>
        <h1>My resume, in full.</h1>
        <p class="lede">A clean view of the same PDF you can download below.</p>
      </div>
      <a class="button button-primary" href={resumePdf} download="Muhammad_Habib_ur_Rehman_Khan_Resume.pdf">Download Resume ↓</a>
    </header>

    <section class="resume-glass" aria-label="Resume PDF viewer">
      <div class="resume-chrome">
        <div class="chrome-lights" aria-hidden="true"><i></i><i></i><i></i></div>
        <span class="chrome-title">habib_resume_9_aug_2026.pdf</span>
        <a href={resumePdf} target="_blank" rel="noreferrer">Open ↗</a>
      </div>
      <div class="resume-paper">
        <iframe title="Muhammad Habib ur Rehman Khan resume" src={resumePdf}></iframe>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .resume-page {
    padding: clamp(4rem, 8vw, 6.5rem) 0 5rem;
  }

  .resume-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.25rem;
  }

  .resume-head h1 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.35rem, 5vw, 4.25rem);
  }

  .resume-head .lede {
    margin: .85rem 0 0;
  }

  /* The viewer is intentionally restrained: the glass effect frames the real PDF
     instead of trying to restyle or recreate the resume itself. */
  .resume-glass {
    position: relative;
    padding: .75rem;
    border: 1px solid color-mix(in srgb, var(--text) 13%, transparent);
    border-radius: 1.5rem;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--surface) 76%, transparent),
      color-mix(in srgb, var(--bg) 66%, transparent));
    box-shadow:
      0 32px 90px rgba(20, 30, 25, .14),
      inset 0 1px 0 rgba(255,255,255,.72),
      inset 0 0 0 1px rgba(255,255,255,.16);
    backdrop-filter: blur(24px) saturate(125%);
    -webkit-backdrop-filter: blur(24px) saturate(125%);
    overflow: hidden;
  }

  [data-theme="dark"] .resume-glass {
    box-shadow:
      0 32px 90px rgba(0, 0, 0, .34),
      inset 0 1px 0 rgba(255,255,255,.08),
      inset 0 0 0 1px rgba(255,255,255,.03);
  }

  .resume-glass::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at 8% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 28%);
  }

  .resume-chrome {
    position: relative;
    z-index: 1;
    min-height: 2.8rem;
    display: grid;
    grid-template-columns: 5rem 1fr 5rem;
    align-items: center;
    gap: .75rem;
    padding: 0 .55rem;
    color: var(--muted);
    font: .68rem ui-monospace, "Cascadia Code", monospace;
  }

  .chrome-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
  }

  .resume-chrome a {
    justify-self: end;
    color: var(--muted);
  }

  .resume-chrome a:hover { color: var(--accent); }

  .chrome-lights { display: flex; gap: .35rem; }
  .chrome-lights i {
    width: .48rem;
    height: .48rem;
    border-radius: 50%;
    display: block;
    background: color-mix(in srgb, var(--text) 18%, transparent);
  }
  .chrome-lights i:first-child { background: color-mix(in srgb, var(--accent) 58%, var(--surface)); }

  .resume-paper {
    position: relative;
    height: min(82vh, 1050px);
    min-height: 680px;
    overflow: hidden;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 16px 45px rgba(0,0,0,.16);
  }

  .resume-paper iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  @media (max-width: 700px) {
    .resume-head {
      align-items: start;
      flex-direction: column;
    }

    .resume-head .button { width: 100%; }
    .resume-glass { padding: .45rem; border-radius: 1rem; }
    .resume-chrome { grid-template-columns: 3.5rem 1fr 3.5rem; }
    .resume-paper { height: 76vh; min-height: 560px; border-radius: .7rem; }
  }
</style>
