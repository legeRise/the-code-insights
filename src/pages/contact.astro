---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact">
  <article class="narrow contact-page">
    <div class="contact-intro">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk about what you're building.</h1>
      <p class="lede">Have a role, project, collaboration, or technical problem worth discussing? Send a message and I'll get back to you.</p>
    </div>

    <form class="contact-form" id="contact-form">
      <label>
        Your name
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        Your email
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        Message
        <textarea name="message" required placeholder="Tell me a little about what you have in mind..."></textarea>
      </label>
      <button type="submit">Compose message →</button>
      <p class="contact-note">This opens your email client with the message prepared. Your email address is not displayed on the site.</p>
    </form>
  </article>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '');
    const email = String(data.get('email') || '');
    const message = String(data.get('message') || '');
    const recipient = atob('b2ZmaWNpYWwuaGFiaWI5MkBnbWFpbC5jb20=');
    const subject = encodeURIComponent(`Message from ${name}`);
    const body = encodeURIComponent(`Name: ${name}\nReply email: ${email}\n\n${message}`);
    window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
  });
</script>
