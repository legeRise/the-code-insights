---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact">
  <article class="narrow contact-page">
    <div class="contact-intro">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk.</h1>
      <p class="lede">Have a role, project, collaboration, or technical problem worth discussing? Pick whichever way feels easiest.</p>
    </div>

    <div class="contact-options">
      <section class="contact-option">
        <div>
          <p class="eyebrow">01 · Book a conversation</p>
          <h2>Let's find a time.</h2>
          <p>Book a 30-minute call and we can talk through an opportunity, project, or idea.</p>
        </div>
        <div class="quick-links">
          <a class="button button-primary" href="https://calendly.com/official-habib92/30min" target="_blank" rel="noreferrer">Book a 30-minute meeting ↗</a>
        </div>
      </section>

      <section class="contact-option contact-quick-links">
        <div>
          <p class="eyebrow">02 · WhatsApp</p>
          <h2>Prefer a quick message?</h2>
          <p>Message me directly on WhatsApp. My number stays off the page.</p>
        </div>
        <div class="quick-links">
          <a class="button whatsapp-button" href="https://wa.me/923195522591" target="_blank" rel="noreferrer">Chat on WhatsApp ↗</a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
