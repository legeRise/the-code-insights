---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact">
  <article class="narrow contact-page">
    <div class="contact-intro">
      <p class="eyebrow">Contact</p>
      <h1>Let's build something useful.</h1>
      <p class="lede">Have a role, project, collaboration, or technical problem worth discussing? Pick the easiest way to reach me.</p>
    </div>

    <div class="contact-options">
      <section class="contact-option">
        <div><p class="eyebrow">01 · Message</p><h2>Send a message</h2><p>Tell me what you're working on and I'll get back to you.</p></div>
        <form class="contact-form" id="contact-form">
          <label>Your name<input name="name" type="text" autocomplete="name" required /></label>
          <label>Your email<input name="email" type="email" autocomplete="email" required /></label>
          <label>Message<textarea name="message" required placeholder="Tell me a little about what you have in mind..."></textarea></label>
          <input name="website" type="text" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <button class="button button-primary" type="submit" id="send-button">Send message →</button>
          <p class="contact-status" id="contact-status" role="status" aria-live="polite"></p>
        </form>
      </section>

      <section class="contact-option contact-quick-links">
        <div><p class="eyebrow">02 · Quick ways</p><h2>Prefer something direct?</h2><p>Choose a time for a conversation or message me on WhatsApp.</p></div>
        <div class="quick-links">
          <a class="button button-primary" href="https://calendly.com/official-habib92/30min" target="_blank" rel="noreferrer">Book a 30-minute call ↗</a>
          <a class="button whatsapp-button" href="https://wa.me/923195522591" target="_blank" rel="noreferrer">Message me on WhatsApp ↗</a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#contact-status');
  const button = document.querySelector<HTMLButtonElement>('#send-button');
  const topic = 'ci-contact-5DvEjBYdyM77WhpFy6yLxxZ1EzBvAX-hzD3Np-JDqageqHM6uTD5inRwL4m67bJT';

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (status) status.textContent = '';
    const data = new FormData(form);
    if (String(data.get('website') || '').trim()) return;

    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const message = String(data.get('message') || '').trim();
    const notification = `New message — The Code Insight\n\nName: ${name}\nEmail: ${email}\n\n${message}`;

    if (button) { button.disabled = true; button.textContent = 'Sending…'; }
    try {
      const response = await fetch(`https://ntfy.sh/${topic}`, {
        method: 'POST',
        headers: { 'Title': 'New portfolio contact', 'Priority': 'high', 'Tags': 'incoming_mail' },
        body: notification,
      });
      if (!response.ok) throw new Error('Notification failed');
      form.reset();
      if (status) status.textContent = 'Message sent. Thanks for reaching out — I’ll get back to you soon.';
    } catch {
      if (status) status.textContent = 'Something went wrong while sending. Please try WhatsApp or book a call instead.';
    } finally {
      if (button) { button.disabled = false; button.textContent = 'Send message →'; }
    }
  });
</script>
