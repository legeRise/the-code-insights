---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <article class="contact-page">
    <header class="contact-intro">
      <p class="eyebrow">CONTACT</p>
      <h1>Let's talk.</h1>
      <p class="lede">Have an opportunity, project, or idea worth discussing? Choose the way that works best for you.</p>
    </header>

    <div class="contact-options">
      <a class="contact-card contact-card-primary" href="https://calendly.com/official-habib92/30min" target="_blank" rel="noreferrer">
        <div class="card-top">
          <span class="card-index">01</span>
          <span class="card-arrow">↗</span>
        </div>
        <div class="card-body">
          <p class="card-label">BOOK A CALL</p>
          <h2>Let's find a time.</h2>
          <p>Book a 30-minute conversation about a role, project, collaboration, or idea.</p>
        </div>
        <span class="card-link">Book a 30-minute meeting <span>↗</span></span>
      </a>

      <a class="contact-card" href="https://wa.me/923195522591" target="_blank" rel="noreferrer">
        <div class="card-top">
          <span class="card-index">02</span>
          <span class="card-arrow">↗</span>
        </div>
        <div class="card-body">
          <p class="card-label">WHATSAPP</p>
          <h2>Prefer a quick message?</h2>
          <p>Start a direct conversation on WhatsApp. My number stays off the page.</p>
        </div>
        <span class="card-link">Chat on WhatsApp <span>↗</span></span>
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .contact-page {
    width: min(980px, 100%);
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 8rem) 0 8rem;
  }

  .contact-intro {
    width: min(700px, 100%);
    margin: 0 auto 4rem;
    text-align: center;
  }

  .eyebrow,
  .card-label {
    margin: 0 0 .8rem;
    color: #168b76;
    font: 700 .68rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .18em;
  }

  .contact-intro h1 {
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: .92;
    letter-spacing: -.07em;
  }

  .lede {
    max-width: 560px;
    margin: 1.25rem auto 0;
    color: var(--muted);
    font-size: 1.03rem;
    line-height: 1.7;
  }

  .contact-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-card {
    position: relative;
    min-height: 330px;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid rgba(31, 45, 42, .11);
    border-radius: 24px;
    background: rgba(255, 255, 255, .72);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 45px rgba(27, 43, 39, .055);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: rgba(31, 45, 42, .18);
    box-shadow: 0 25px 60px rgba(27, 43, 39, .10);
  }

  .contact-card-primary {
    border-color: rgba(22, 139, 118, .22);
    background: linear-gradient(145deg, rgba(239, 250, 247, .96), rgba(255,255,255,.82));
    box-shadow: 0 22px 55px rgba(22, 139, 118, .10);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-index {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(31,45,42,.10);
    border-radius: 50%;
    color: var(--muted);
    font: 600 .72rem ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .card-arrow {
    font-size: 1.25rem;
    color: var(--muted);
  }

  .card-body {
    margin-top: auto;
    padding: 3rem .2rem 2.25rem;
  }

  .card-label {
    margin-bottom: .65rem;
  }

  .card-body h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.45rem);
    line-height: 1.02;
    letter-spacing: -.045em;
  }

  .card-body p:not(.card-label) {
    max-width: 390px;
    margin: .9rem 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    align-self: flex-start;
    padding: .72rem .95rem;
    border-radius: 10px;
    background: #168b76;
    color: #fff;
    font-weight: 650;
    font-size: .86rem;
    box-shadow: 0 8px 20px rgba(22, 139, 118, .16);
  }

  .contact-card:not(.contact-card-primary) .card-link {
    background: #17211f;
    box-shadow: 0 8px 20px rgba(23,33,31,.12);
  }

  .card-link span {
    transition: transform .2s ease;
  }

  .contact-card:hover .card-link span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 700px) {
    .contact-page {
      padding: 4rem 0 5rem;
    }

    .contact-intro {
      margin-bottom: 2.5rem;
    }

    .contact-intro h1 {
      font-size: clamp(3.1rem, 15vw, 5rem);
    }

    .contact-options {
      grid-template-columns: 1fr;
    }

    .contact-card {
      min-height: 280px;
    }
  }
</style>
