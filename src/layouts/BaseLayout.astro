---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const {
  title = 'The Code Insight — Software, Systems & Articles',
  description = 'The Code Insight is Muhammad Habib ur Rehman Khan\'s space for software projects, production systems, technical articles, and engineering work.',
} = Astro.props;
const pageTitle = title === 'The Code Insight — Software, Systems & Articles' ? title : `${title} — The Code Insight`;
const path = Astro.url.pathname;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const url = (path = '') => `${base}${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0d0c" />
    <link rel="alternate" type="application/rss+xml" title="Articles" href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <title>{pageTitle}</title>
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) document.documentElement.dataset.theme = 'dark';
      else document.documentElement.dataset.theme = 'light';
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="shell nav" aria-label="Main navigation">
        <a class="brand" href={url()}>The Code Insight<span class="brand-dot">.</span></a>
        <a class="nav-link" aria-current={path.startsWith(url('projects')) ? 'page' : undefined} href={url('projects')}>Work</a>
        <a class="nav-link" aria-current={path.startsWith(url('articles')) ? 'page' : undefined} href={url('articles')}>Articles</a>
        <a class="nav-link" aria-current={path === url('resume') || path === `${url('resume')}/` ? 'page' : undefined} href={url('resume')}>My Resume</a>
        <a class="nav-link" aria-current={path === url('about') || path === `${url('about')}/` ? 'page' : undefined} href={url('about')}>About</a>
        <a class="nav-link" aria-current={path === url('contact') || path === `${url('contact')}/` ? 'page' : undefined} href={url('contact')}>Contact</a>
        <a class="nav-link" href="https://github.com/legeRise" target="_blank" rel="noreferrer">GitHub ↗</a>
        <button class="theme-button" id="theme" aria-label="Toggle color theme">◐</button>
      </nav>
    </header>
    <main class="shell"><slot /></main>
    <footer class="site-footer"><div class="shell">The Code Insight · Muhammad Habib ur Rehman Khan · <span>{new Date().getFullYear()}</span></div></footer>
    <script>
      document.querySelector('#theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
